<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds block cleartext HTTP by default, which would break every call to
  the API at http://192.168.1.53:8000. Cleartext is re-enabled for that one host
  only — everything else on the internet still requires HTTPS.

  This is an interim measure for internal distribution. Before a public Play
  Store release the backend needs a real domain with a TLS certificate, and this
  whole file should be deleted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.53</domain>
    </domain-config>
</network-security-config>
