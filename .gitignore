# Secrets & Credentials
*.pem
*.key
.env
.env.*
# Template of required variables with placeholder values only — no secrets.
!.env.example
# Public Mozilla CA root bundle — no private key material, needed at runtime
# so outbound HTTPS calls (e.g. Fast2SMS) don't depend on the server's own
# (possibly stale) system CA store.
!salary-slip-bac/storage/certs/cacert.pem

# Dependencies
node_modules/
vendor/

# Build and deployment files
*.zip
*.tar.gz
dist/
build/
dev-dist/

# OS generated files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/

# Backend
uploads/
*.log
coverage/

# Database dumps / snapshots (may contain PII — never commit)
*.bak
*.sqlite
*.sqlite.*
*.dump
*.pgsql

temp_deploy/
*.zip
.phpunit.result.cache
