  status                                             String    @default("active") @db.VarChar(16)
  effective_from                                     DateTime  @db.Date
  effective_to                                       DateTime? @db.Date
  reason                                             String?
  assigned_by                                        BigInt?
  revoked_by                                         BigInt?
  revoked_at                                         DateTime? @db.Timestamp(0)
  revocation_reason                                  String?
  created_at                                         DateTime? @db.Timestamp(0)
  updated_at                                         DateTime? @db.Timestamp(0)
  users_company_admin_assignments_assigned_byTousers users?    @relation("company_admin_assignments_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction, map: "company_admin_assignments_assigned_by_foreign")
  companies                                          companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "company_admin_assignments_company_id_foreign")
  users_company_admin_assignments_revoked_byTousers  users?    @relation("company_admin_assignments_revoked_byTousers", fields: [revoked_by], references: [id], onUpdate: NoAction, map: "company_admin_assignments_revoked_by_foreign")
  users_company_admin_assignments_user_idTousers     users     @relation("company_admin_assignments_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "company_admin_assignments_user_id_foreign")

  @@index([company_id, status], map: "company_admin_assignments_company_id_status_index")
  @@index([user_id, status], map: "company_admin_assignments_user_id_status_index")
}

model company_documents {
  id                        BigInt          @id @default(autoincrement())
  company_id                BigInt
