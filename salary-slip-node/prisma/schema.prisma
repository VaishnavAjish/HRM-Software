  users                     users?          @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "company_documents_created_by_foreign")
  legal_entities            legal_entities? @relation(fields: [legal_entity_id], references: [id], onUpdate: NoAction, map: "company_documents_legal_entity_id_foreign")

  @@index([company_id, document_type, status], map: "company_documents_company_id_document_type_status_index")
  @@index([expires_at], map: "company_documents_expires_at_index")
}

model company_module_activations {
