generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model aadhaar_export_authorizations {
  id                                                        BigInt    @id @default(autoincrement())
  uuid                                                      String    @unique(map: "aadhaar_export_authorizations_uuid_unique") @db.Uuid
  token_hash                                                String    @unique(map: "aadhaar_export_authorizations_token_hash_unique") @db.VarChar(64)
  actor_user_id                                             BigInt
  target_user_id                                            BigInt
  surface                                                   String    @db.VarChar(32)
  export_type                                               String    @db.VarChar(16)
  permission                                                String    @db.VarChar(255)
  organization_code                                         String?   @db.VarChar(255)
  unit                                                      String?   @db.VarChar(255)
  expires_at                                                DateTime  @db.Timestamp(0)
  used_at                                                   DateTime? @db.Timestamp(0)
  request_id                                                String?   @db.VarChar(255)
  audit_log_id                                              BigInt?
  created_at                                                DateTime? @db.Timestamp(0)
  updated_at                                                DateTime? @db.Timestamp(0)
  users_aadhaar_export_authorizations_actor_user_idTousers  users     @relation("aadhaar_export_authorizations_actor_user_idTousers", fields: [actor_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "aadhaar_export_authorizations_actor_user_id_foreign")
  users_aadhaar_export_authorizations_target_user_idTousers users     @relation("aadhaar_export_authorizations_target_user_idTousers", fields: [target_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "aadhaar_export_authorizations_target_user_id_foreign")

  @@index([actor_user_id, target_user_id], map: "aadhaar_export_authorizations_actor_user_id_target_user_id_inde")
  @@index([expires_at], map: "aadhaar_export_authorizations_expires_at_index")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approval_levels {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  level      Int       @default(1)
  type       String    @default("Manual Approval") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model attendances {
  id           BigInt    @id @default(autoincrement())
  emp_code     String    @db.VarChar(255)
  company_code String    @db.VarChar(255)
  unit         String?   @db.VarChar(255)
  date         DateTime  @db.Date
  status       String    @db.VarChar(255)
  marked_by    BigInt?
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  users        users?    @relation(fields: [marked_by], references: [id], onUpdate: NoAction, map: "attendances_marked_by_foreign")

  @@unique([emp_code, company_code, date], map: "attendances_emp_code_company_code_date_unique")
  @@index([company_code, unit, date], map: "attendances_company_code_unit_date_index")
}

model audit_logs {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt?
  action     String    @db.VarChar(255)
  module     String    @db.VarChar(255)
  old_value  Json?     @db.Json
  new_value  Json?     @db.Json
  ip_address String?   @db.VarChar(255)
  user_agent String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_foreign")

  @@index([created_at], map: "audit_logs_created_at_index")
  @@index([module], map: "audit_logs_module_index")
}

model auth_sessions {
  id                                    BigInt    @id @default(autoincrement())
  user_id                               BigInt
  token_id                              String    @unique(map: "auth_sessions_token_id_unique") @db.VarChar(64)
  ip                                    String?   @db.VarChar(64)
  user_agent                            String?   @db.VarChar(512)
  device_label                          String?   @db.VarChar(190)
  last_seen_at                          DateTime? @db.Timestamp(0)
  revoked_at                            DateTime? @db.Timestamp(0)
  revoked_by                            BigInt?
  revoke_reason                         String?   @db.VarChar(190)
  created_at                            DateTime? @db.Timestamp(0)
  updated_at                            DateTime? @db.Timestamp(0)
  users_auth_sessions_revoked_byTousers users?    @relation("auth_sessions_revoked_byTousers", fields: [revoked_by], references: [id], onUpdate: NoAction, map: "auth_sessions_revoked_by_foreign")
  users_auth_sessions_user_idTousers    users     @relation("auth_sessions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_sessions_user_id_foreign")

  @@index([user_id, revoked_at], map: "auth_sessions_user_id_revoked_at_index")
}

model branches {
  id          BigInt     @id @default(autoincrement())
  name        String     @db.VarChar(255)
  code        String     @unique(map: "branches_code_unique") @db.VarChar(255)
  location_id BigInt?
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  locations   locations? @relation(fields: [location_id], references: [id], onUpdate: NoAction, map: "branches_location_id_foreign")
}

model branding_configurations {
  id           BigInt     @id @default(autoincrement())
  company_id   BigInt?
  status       String     @default("draft") @db.VarChar(16)
  config       Json       @db.Json
  version      Int        @default(1)
  published_at DateTime?  @db.Timestamp(0)
  published_by BigInt?
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  companies    companies? @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "branding_configurations_company_id_foreign")
  users        users?     @relation(fields: [published_by], references: [id], onUpdate: NoAction, map: "branding_configurations_published_by_foreign")

  @@index([company_id, status], map: "branding_configurations_company_id_status_index")
}

model business_groups {
  id                        BigInt                      @id @default(autoincrement())
  code                      String                      @unique(map: "business_groups_code_unique") @db.VarChar(64)
  name                      String                      @db.VarChar(255)
  registered_name           String?                     @db.VarChar(255)
  group_type                String                      @default("operating") @db.VarChar(32)
  description               String?
  country                   String                      @default("IN") @db.VarChar(8)
  default_currency          String                      @default("INR") @db.VarChar(8)
  timezone                  String                      @default("Asia/Kolkata") @db.VarChar(64)
  status                    String                      @default("active") @db.VarChar(24)
  status_reason             String?
  effective_from            DateTime?                   @db.Date
  effective_to              DateTime?                   @db.Date
  status_changed_by         BigInt?
  created_at                DateTime?                   @db.Timestamp(0)
  updated_at                DateTime?                   @db.Timestamp(0)
  users                     users?                      @relation(fields: [status_changed_by], references: [id], onUpdate: NoAction, map: "business_groups_status_changed_by_foreign")
  group_admin_assignments   group_admin_assignments[]
  group_company_assignments group_company_assignments[]
  group_policies            group_policies[]

  @@index([status], map: "business_groups_status_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model companies {
  id                              BigInt                            @id @default(autoincrement())
  code                            String                            @unique(map: "companies_code_unique") @db.VarChar(64)
  name                            String                            @db.VarChar(255)
  legal_name                      String?                           @db.VarChar(255)
  aliases                         Json?                             @db.Json
  status                          String                            @default("active") @db.VarChar(24)
  timezone                        String                            @default("Asia/Kolkata") @db.VarChar(64)
  default_currency                String                            @default("INR") @db.VarChar(8)
  contract_start                  DateTime?                         @db.Date
  contract_end                    DateTime?                         @db.Date
  status_reason                   String?
  status_changed_by               BigInt?
  created_at                      DateTime?                         @db.Timestamp(0)
  updated_at                      DateTime?                         @db.Timestamp(0)
  registration_number             String?                           @db.VarChar(255)
  industry                        String?                           @db.VarChar(96)
  website                         String?                           @db.VarChar(255)
  primary_email                   String?                           @db.VarChar(255)
  primary_phone                   String?                           @db.VarChar(32)
  registered_address              String?
  fiscal_year_start_month         Int                               @default(4) @db.SmallInt
  branding_configurations         branding_configurations[]
  users                           users?                            @relation(fields: [status_changed_by], references: [id], onUpdate: NoAction, map: "companies_status_changed_by_foreign")
  company_admin_assignments       company_admin_assignments[]
  company_documents               company_documents[]
  company_module_activations      company_module_activations[]
  company_payroll_configurations  company_payroll_configurations[]
  company_statutory_registrations company_statutory_registrations[]
  company_units                   company_units[]
  financial_centres               financial_centres[]
  group_company_assignments       group_company_assignments[]
  legal_entities                  legal_entities[]
  location_calendar_entries       location_calendar_entries[]
  organization_units              organization_units[]
  positions                       positions[]
  workforce_forecasts             workforce_forecasts[]
  workforce_plans                 workforce_plans[]

  @@index([status], map: "companies_status_index")
}

