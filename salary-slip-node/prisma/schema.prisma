model vacancies {
  id                                            BigInt    @id @default(autoincrement())
  position_id                                   BigInt
  source                                        String    @default("new_position") @db.VarChar(24)
  reason                                        String?
  vacancy_date                                  DateTime  @db.Date
  required_by_date                              DateTime? @db.Date
  openings                                      Int       @default(1)
  required_fte                                  Decimal   @default(1) @db.Decimal(8, 2)
  priority                                      String    @default("medium") @db.VarChar(16)
  status                                        String    @default("planned") @db.VarChar(24)
  status_reason                                 String?
  estimated_cost                                Decimal?  @db.Decimal(14, 2)
  hiring_manager_user_id                        BigInt?
  requisition_code                              String?   @unique(map: "vacancies_requisition_code_unique") @db.VarChar(64)
  requisition_created_at                        DateTime? @db.Timestamp(0)
  filled_by_user_id                             BigInt?
  closed_at                                     DateTime? @db.Timestamp(0)
  created_by                                    BigInt?
  created_at                                    DateTime? @db.Timestamp(0)
  updated_at                                    DateTime? @db.Timestamp(0)
  users_vacancies_created_byTousers             users?    @relation("vacancies_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "vacancies_created_by_foreign")
  users_vacancies_filled_by_user_idTousers      users?    @relation("vacancies_filled_by_user_idTousers", fields: [filled_by_user_id], references: [id], onUpdate: NoAction, map: "vacancies_filled_by_user_id_foreign")
  users_vacancies_hiring_manager_user_idTousers users?    @relation("vacancies_hiring_manager_user_idTousers", fields: [hiring_manager_user_id], references: [id], onUpdate: NoAction, map: "vacancies_hiring_manager_user_id_foreign")
  positions                                     positions @relation(fields: [position_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vacancies_position_id_foreign")

  @@index([position_id], map: "vacancies_position_id_index")
  @@index([status, vacancy_date], map: "vacancies_status_vacancy_date_index")
}

model workforce_forecasts {
  id                                            BigInt     @id @default(autoincrement())
  code                                          String     @unique(map: "workforce_forecasts_code_unique") @db.VarChar(96)
  name                                          String     @db.VarChar(255)
  company_id                                    BigInt?
  scenario                                      String     @default("baseline") @db.VarChar(32)
  horizon_months                                Int        @default(12)
  base_date                                     DateTime   @db.Date
  model_version                                 String     @default("deterministic-v1") @db.VarChar(32)
  assumptions                                   Json?      @db.Json
  results                                       Json?      @db.Json
  status                                        String     @default("draft") @db.VarChar(16)
  run_count                                     Int        @default(0)
  generated_at                                  DateTime?  @db.Timestamp(0)
  published_at                                  DateTime?  @db.Timestamp(0)
  published_by                                  BigInt?
  created_by                                    BigInt?
  created_at                                    DateTime?  @db.Timestamp(0)
  updated_at                                    DateTime?  @db.Timestamp(0)
  companies                                     companies? @relation(fields: [company_id], references: [id], onUpdate: NoAction, map: "workforce_forecasts_company_id_foreign")
  users_workforce_forecasts_created_byTousers   users?     @relation("workforce_forecasts_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "workforce_forecasts_created_by_foreign")
  users_workforce_forecasts_published_byTousers users?     @relation("workforce_forecasts_published_byTousers", fields: [published_by], references: [id], onUpdate: NoAction, map: "workforce_forecasts_published_by_foreign")
}

model workforce_plan_lines {
  id                   BigInt              @id @default(autoincrement())
  workforce_plan_id    BigInt
  organization_unit_id BigInt?
  designation_id       BigInt?
  cost_centre_id       BigInt?
  period_key           String              @default("FY") @db.VarChar(16)
  category             String?             @db.VarChar(48)
  opening              Int?
  additions            Int?
  reductions           Int?
  exits                Int?
  closing              Int?
  planned_fte          Decimal?            @db.Decimal(8, 2)
  quantity             Decimal?            @db.Decimal(10, 2)
  unit_cost            Decimal?            @db.Decimal(14, 2)
  amount               Decimal?            @db.Decimal(14, 2)
  justification        String?
  created_at           DateTime?           @db.Timestamp(0)
  updated_at           DateTime?           @db.Timestamp(0)
  financial_centres    financial_centres?  @relation(fields: [cost_centre_id], references: [id], onUpdate: NoAction, map: "workforce_plan_lines_cost_centre_id_foreign")
  designations         designations?       @relation(fields: [designation_id], references: [id], onUpdate: NoAction, map: "workforce_plan_lines_designation_id_foreign")
  organization_units   organization_units? @relation(fields: [organization_unit_id], references: [id], onUpdate: NoAction, map: "workforce_plan_lines_organization_unit_id_foreign")
  workforce_plans      workforce_plans     @relation(fields: [workforce_plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workforce_plan_lines_workforce_plan_id_foreign")

  @@index([workforce_plan_id], map: "workforce_plan_lines_workforce_plan_id_index")
}

