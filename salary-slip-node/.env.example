# salary-slip-node — environment
#
# Several values here MUST match the Laravel app exactly. They are not new
# secrets to generate: they are what existing data was written with.

NODE_ENV=development
PORT=8001
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Must be IDENTICAL to salary-slip-bac/.env — do not generate new values
# ---------------------------------------------------------------------------

# Decrypts every existing users.encrypted_aadhaar_number. A different key does
# not fail at boot; it fails per row, at read time.
APP_KEY=base64:REPLACE_WITH_THE_LARAVEL_APP_KEY

# Tokens already in users' browsers stay valid for up to 30 days. A different
# secret logs every user out at cutover.
JWT_SECRET=REPLACE_WITH_THE_LARAVEL_JWT_SECRET
JWT_TTL=43200

# Permanent data, not a rotatable credential: changing it orphans every
# existing document folder in S3.
AADHAAR_REFERENCE_SECRET=REPLACE_WITH_THE_LARAVEL_SECRET

# ---------------------------------------------------------------------------
# Database — production is PostgreSQL
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/niss_hrms?schema=public

# ---------------------------------------------------------------------------
# CORS — comma separated. Empty means "reject all cross-origin requests".
# The PHP app currently allows '*'; do not carry that over.
# ---------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,https://niss.pro
