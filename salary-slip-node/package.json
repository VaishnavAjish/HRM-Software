{
  "name": "salary-slip-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js backend for the HRMS API — incremental replacement for salary-slip-bac (Laravel).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "php scripts/generate-fixtures.php",
    "parity": "tsx scripts/parity-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pino": "^9.6.0",
    "prisma": "^6.19.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.2"
  }
}
