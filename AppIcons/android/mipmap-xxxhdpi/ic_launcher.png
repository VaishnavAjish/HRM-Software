	else [rr, gg, bb] = validateColorComponents(rgb, {
		maxLength: TRIA,
		maxRange: MAX_RGB
	});
	let r = rr / MAX_RGB;
	let g = gg / MAX_RGB;
	let b = bb / MAX_RGB;
	const COND_POW = .04045;
	if (r > COND_POW) r = Math.pow((r + LINEAR_OFFSET) / 1.055, POW_LINEAR);
	else r /= LINEAR_COEF;
	if (g > COND_POW) g = Math.pow((g + LINEAR_OFFSET) / 1.055, POW_LINEAR);
	else g /= LINEAR_COEF;
	if (b > COND_POW) b = Math.pow((b + LINEAR_OFFSET) / 1.055, POW_LINEAR);
	else b /= LINEAR_COEF;
	return [
