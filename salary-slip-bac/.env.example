APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

# --- Auth ---
# php artisan jwt:secret
JWT_SECRET=
# Minutes. Leave unset to use the config default (30 days).
JWT_TTL=
JWT_REFRESH_TTL=

# Seeded super-admin password for a fresh install. Set this so a new
# environment does not start with the value committed in DatabaseSeeder.
SEED_SUPER_ADMIN_PASSWORD=

# --- Cache / queue ---
# Laravel 11+ reads CACHE_STORE, not the older CACHE_DRIVER.
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Document storage -------------------------------------------------------
# local = legacy public/uploads. s3 = private bucket + presigned URLs.
DOCUMENT_STORAGE_PROVIDER=local
# Allow reads of rows that still point at local files during migration.
DOCUMENT_LEGACY_READ_ENABLED=true

AWS_REGION=ap-south-1
AWS_S3_BUCKET=company-documents-dev
# Only for S3-compatible local dev (MinIO/LocalStack). Leave blank for real AWS.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# AES256 (SSE-S3) or aws:kms (SSE-KMS)
AWS_S3_ENCRYPTION=AES256
AWS_KMS_KEY_ID=
AWS_S3_STORAGE_CLASS=STANDARD

# Leave these EMPTY in production — the SDK resolves the EC2/ECS/EKS role via
# the default credential chain. Populate only for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

DOCUMENT_VIEW_URL_TTL_SECONDS=300
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
# SOFT_DELETE | ARCHIVE | PERMANENT
DOCUMENT_ARCHIVE_MODE=SOFT_DELETE
DOCUMENT_MALWARE_SCAN_ENABLED=false
DOCUMENT_UPLOAD_CONCURRENCY=3
DOCUMENT_MULTIPART_THRESHOLD_BYTES=8388608
DOCUMENT_MULTIPART_PART_SIZE_BYTES=8388608

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.titan.email
MAIL_PORT=587
MAIL_USERNAME=admin@niss.pro
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@niss.pro
MAIL_FROM_NAME="${APP_NAME}"

CORS_ORIGIN=http://localhost:5173

# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Permanent once documents exist — changing it orphans every S3 folder.
AADHAAR_REFERENCE_SECRET=

# Full-Aadhaar Print and server-generated PDF export. Leave false until the
# permissions have been granted to a test role and the output verified in a
# browser. Masked Print and masked PDF are unaffected by this flag.
CONFIDENTIAL_AADHAAR_EXPORT_ENABLED=false
AADHAAR_EXPORT_TOKEN_TTL_SECONDS=60

FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
