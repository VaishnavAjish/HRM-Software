<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP only to local dev-backend addresses, for testing against
  a locally running Laravel server (npm run mobile:build:local). All other
  traffic still requires HTTPS via the default base-config below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine's localhost -->
        <domain includeSubdomains="true">niss.pro</domain>
        <domain includeSubdomains="false">13.53.112.45</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
